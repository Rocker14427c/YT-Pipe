    <color name="subscribed_background_color">@color/yt_light_surface_pressed</color>
    <color name="subscribed_text_color">@color/yt_light_text_secondary</color>
    <color name="show_replies_button_text_color">@color/yt_light_link</color>

    <color name="transparent_background_color">#00000000</color>
