<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Global role aliases. Screens should consume roles rather than hard-coded colors. -->
    <color name="contrastColor">@color/yt_light_text_primary</color>
    <color name="defaultIconTint">?android:attr/textColorPrimary</color>

    <color name="ic_launcher_background">@color/yt_red_strong</color>
    <color name="placeholder_background">#FF9E9E9E</color>
    <color name="placeholder_foreground">#FF6C6C6C</color>

    <!-- Light theme: neutral YouTube surfaces with red as an action color. -->
    <color name="light_background_color">@color/yt_light_background</color>
    <color name="light_dialog_background_color">@color/yt_light_surface</color>
    <color name="light_settings_accent_color">@color/yt_red</color>
    <color name="light_separator_color">@color/yt_light_divider</color>
    <color name="light_ripple_color">#1F0F0F0F</color>
    <color name="light_selected_color">@color/yt_light_surface_pressed</color>
    <color name="light_contrast_background_color">@color/yt_light_surface_variant</color>
    <color name="light_shadow_start_color">#30000000</color>
    <color name="light_license_background_color">@color/yt_light_surface</color>
    <color name="light_license_text_color">@color/yt_light_text_primary</color>
    <color name="light_card_item_background_color">@color/yt_light_surface</color>
    <color name="light_card_item_contrast_color">@color/yt_light_surface_variant</color>
    <color name="light_border_color">@color/yt_light_divider</color>

    <!-- Dark theme: layered surfaces, never a flat inverted light palette. -->
    <color name="dark_background_color">@color/yt_dark_background</color>
    <color name="dark_dialog_background_color">@color/yt_dark_surface</color>
    <color name="dark_settings_accent_color">@color/yt_red</color>
    <color name="dark_separator_color">@color/yt_dark_divider</color>
    <color name="dark_ripple_color">#33FFFFFF</color>
    <color name="dark_selected_color">@color/yt_dark_surface_pressed</color>
    <color name="dark_contrast_background_color">@color/yt_dark_surface_variant</color>
    <color name="dark_shadow_start_color">#82000000</color>
    <color name="dark_license_background_color">@color/yt_dark_surface</color>
    <color name="dark_license_text_color">@color/yt_dark_text_primary</color>
    <color name="dark_queue_background_color">#E6000000</color>
    <color name="dark_card_item_background_color">@color/yt_dark_surface</color>
    <color name="dark_card_item_contrast_color">@color/yt_dark_surface_variant</color>
    <color name="dark_border_color">@color/yt_dark_divider</color>
    <color name="dark_bottom_sheet_color">@color/yt_dark_surface</color>

    <!-- Black theme for users who explicitly choose OLED surfaces. -->
    <color name="black_background_color">#FF000000</color>
    <color name="black_settings_accent_color">@color/yt_red</color>
    <color name="black_separator_color">#FF2A2A2A</color>
