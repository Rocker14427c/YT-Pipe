    <color name="queue_background_color">@color/dark_queue_background_color</color>
    <color name="drawer_header_font_color">#FFFFFFFF</color>
    <color name="duration_background_color">@color/yt_duration_overlay</color>
    <color name="live_duration_background_color">#D9FF0033</color>
    <color name="paid_video_background_color">#FFCC9900</color>
